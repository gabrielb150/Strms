# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Spotify Web API (photos, genres, ISRCs). Create an app at https://developer.spotify.com/dashboard
# The account that owns the app must have Spotify Premium (Development Mode rule since Feb 2026).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Paid sources (leave empty until you have access; see README "Adding Chartmetric or Luminate")
CHARTMETRIC_REFRESH_TOKEN=
LUMINATE_API_KEY=

# Optional: override the user agent sent to data sources (default is in config/pipeline.json)
# PIPELINE_USER_AGENT=
